/target/
**/*.rs.bk
*.pdb

.cargo/
.qdrant/
.data/
*.redb
*.redb.lock

.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db

*.local.toml
.env
.env.*

# One-off patch and verification transcripts are scratch, not qualification evidence.
# Check evidence belongs to the exact PR/run and the current registry.
*-patch.log
/runtime-verification.log

# Generated caches are not source or qualification evidence.
__pycache__/
*.py[cod]

# Preserve local outputs from retired tooling; never stage them as source.
/artifacts/
/swarm/
/qualification/*
!/qualification/README.md
